---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const trim = (path: string) => path.replace(/\/$/, '');
const pathname = trim(Astro.url.pathname);
const target = trim(String(href));
const home = trim(import.meta.env.BASE_URL);
const isActive = pathname === target || (target !== home && pathname.startsWith(target + '/'));
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
<style>
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover,
	a.active {
		color: var(--text);
	}
	a.active {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.45em;
	}
</style>
