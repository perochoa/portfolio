---
import { withBase } from '../utils';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="wordmark" href={withBase("/")}>Alex Perocho<span aria-hidden="true">.</span></a>
		<div class="links">
			<HeaderLink href={withBase("/experience")}>Experience</HeaderLink>
			<HeaderLink href={withBase("/blog")}>Blog</HeaderLink>
			<HeaderLink href={withBase("/about")}>About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(1.5) blur(10px);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: calc(var(--wide) + 2 * var(--gutter));
		height: 3.5rem;
		margin: 0 auto;
		padding: 0 var(--gutter);
	}
	.wordmark {
		font-weight: 600;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.wordmark:hover {
		color: inherit;
	}
	.wordmark span {
		color: var(--accent);
	}
	.links {
		display: flex;
		gap: 1.5rem;
		font-size: 0.925rem;
	}
	@media (max-width: 480px) {
		.links {
			gap: 1rem;
		}
	}
</style>
