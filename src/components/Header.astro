---
import { withBase } from '../utils';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
---

<header>
	<nav>
		<a class="home" href={withBase("/")} aria-label="Perocho, home"><Logo /></a>
		<div class="links">
			<HeaderLink href={withBase("/experience/")}>Experience</HeaderLink>
			<HeaderLink href={withBase("/blog/")}>Blog</HeaderLink>
			<HeaderLink href={withBase("/about/")}>About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(1.5) blur(10px);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: calc(var(--wide) + 2 * var(--gutter));
		height: 3.5rem;
		margin: 0 auto;
		padding: 0 var(--gutter);
	}
	.home {
		display: flex;
		text-decoration: none;
	}
	.links {
		display: flex;
		gap: 1.5rem;
		font-size: 0.925rem;
	}
	@media (max-width: 480px) {
		.links {
			gap: 1rem;
		}
	}
</style>
