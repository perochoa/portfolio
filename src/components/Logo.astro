---
// The perocho lockup: eight-leaf symbol plus wordmark. Geometry comes from
// brand/style-guide.html; the symbol and wordmark are separate SVGs so the
// wordmark can be dropped where the lockup would fall under its minimum size.
const LEAF =
	'M32 27C34.21 21.63 36.42 17.29 35.68 12.5C35.09 9.98 33.47 8 32 6.5C30.53 8 28.91 9.98 28.32 12.5C27.58 17.29 29.79 21.63 32 27Z';
const ANGLES = [0, 45, 90, 135, 180, 225, 270, 315];
// Outlined "perocho." glyphs as [x offset, path]; the last one is the period.
const GLYPHS: [number, string][] = [
	[0, 'M70 -150V534H193L196 420L183 426Q203 485 248.5 515.5Q294 546 355 546Q431 546 481.5 508.0Q532 470 557.0 407.0Q582 344 582 267Q582 190 556.5 127.0Q531 64 480.5 26.0Q430 -12 354 -12Q314 -12 279.5 2.0Q245 16 220.5 42.0Q196 68 186 103L198 113V-150ZM324 92Q382 92 415.5 138.5Q449 185 449 267Q449 349 415.5 395.5Q382 442 324 442Q285 442 257.0 422.5Q229 403 213.5 364.0Q198 325 198 267Q198 209 213.0 170.0Q228 131 256.5 111.5Q285 92 324 92Z'],
	[581, 'M301 -12Q221 -12 162.0 22.5Q103 57 71.0 120.0Q39 183 39 267Q39 351 71.0 413.5Q103 476 161.5 511.0Q220 546 298 546Q374 546 431.5 512.0Q489 478 520.0 414.0Q551 350 551 260V231H172Q176 161 210.5 125.5Q245 90 302 90Q345 90 373.5 109.5Q402 129 413 164L544 156Q522 78 457.5 33.0Q393 -12 301 -12ZM172 317H419Q415 382 382.0 413.5Q349 445 298 445Q247 445 213.5 412.0Q180 379 172 317Z'],
	[1132, 'M70 0V534H190L195 386L184 388Q196 465 229.5 499.5Q263 534 321 534H370V424H320Q279 424 252.0 412.0Q225 400 211.5 374.5Q198 349 198 308V0Z'],
	[1501, 'M302 -12Q223 -12 163.5 22.5Q104 57 71.5 120.0Q39 183 39 267Q39 352 71.5 414.5Q104 477 163.5 511.5Q223 546 302 546Q381 546 440.0 511.5Q499 477 531.5 414.5Q564 352 564 267Q564 183 531.5 120.0Q499 57 440.0 22.5Q381 -12 302 -12ZM302 92Q364 92 397.5 138.0Q431 184 431 267Q431 349 397.5 395.5Q364 442 302 442Q240 442 206.0 395.5Q172 349 172 267Q172 184 206.0 138.0Q240 92 302 92Z'],
	[2064, 'M302 -12Q222 -12 163.0 22.5Q104 57 71.5 120.0Q39 183 39 267Q39 351 71.5 413.5Q104 476 163.0 511.0Q222 546 302 546Q370 546 423.0 522.0Q476 498 509.5 453.5Q543 409 551 345L419 338Q411 389 379.5 415.5Q348 442 302 442Q240 442 206.0 395.5Q172 349 172 267Q172 184 206.0 138.0Q240 92 302 92Q349 92 380.5 119.0Q412 146 419 203L551 197Q543 133 510.0 86.0Q477 39 424.0 13.5Q371 -12 302 -12Z'],
	[2604, 'M70 0V710H198V412H182Q190 458 214.0 487.5Q238 517 273.0 531.5Q308 546 350 546Q409 546 449.5 520.5Q490 495 510.5 449.0Q531 403 531 343V0H403V312Q403 377 381.0 409.5Q359 442 312 442Q260 442 229.0 408.0Q198 374 198 309V0Z'],
	[3165, 'M302 -12Q223 -12 163.5 22.5Q104 57 71.5 120.0Q39 183 39 267Q39 352 71.5 414.5Q104 477 163.5 511.5Q223 546 302 546Q381 546 440.0 511.5Q499 477 531.5 414.5Q564 352 564 267Q564 183 531.5 120.0Q499 57 440.0 22.5Q381 -12 302 -12ZM302 92Q364 92 397.5 138.0Q431 184 431 267Q431 349 397.5 395.5Q364 442 302 442Q240 442 206.0 395.5Q172 349 172 267Q172 184 206.0 138.0Q240 92 302 92Z'],
	[3728, 'M39 0V140H185V0Z'],
];
---

<span class="logo">
	<svg class="symbol" viewBox="6.5 6.5 51 51" aria-hidden="true">
		{ANGLES.map((angle) => <path class:list={[{ accent: angle === 45 }]} d={LEAF} transform={`rotate(${angle} 32 32)`} />)}
	</svg>
	<svg class="wordmark" viewBox="70 -710 3843 860" aria-hidden="true">
		{
			GLYPHS.map(([x, d], i) => (
				<path class:list={[{ accent: i === GLYPHS.length - 1 }]} d={d} transform={`translate(${x} 0) scale(1 -1)`} />
			))
		}
	</svg>
</span>
<style>
	.logo {
		--logo-height: 1.5rem;
		display: inline-flex;
		align-items: center;
		/* 0.33 of the font size, which is the logo height / 0.86 */
		gap: calc(var(--logo-height) * 0.3837);
		color: var(--text);
	}
	svg {
		display: block;
		width: auto;
		height: var(--logo-height);
		fill: currentColor;
	}
	.accent {
		fill: var(--accent);
	}
	/* Below the lockup's minimum size the symbol stands alone. */
	@media (max-width: 400px) {
		.wordmark {
			display: none;
		}
	}
</style>
