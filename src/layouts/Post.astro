---
import Base from "../layouts/Base.astro";

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article>
    <h1>{frontmatter.title}</h1>
    <div style="font-size: 0.9rem; color: #666; margin-bottom: 2rem;">
      {new Date(frontmatter.date).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </div>
    
    <slot />
    
    <hr style="margin: 3rem 0; border: none; border-top: 1px solid var(--color-border);" />
    <p><a href="/blog">← Back to blog</a></p>
  </article>
</Base>
