---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils';
---

<BaseLayout title={`Page not found | ${SITE_TITLE}`} description="This page doesn't exist.">
	<main>
		<h1>Page not found</h1>
		<p>There's nothing here. Try the <a href={withBase("/")}>home page</a> or the <a href={withBase("/blog")}>blog</a>.</p>
	</main>
</BaseLayout>
