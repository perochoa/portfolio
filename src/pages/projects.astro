---
import Base from "../layouts/Base.astro";

const projects = [
  {
    title: "Project 1",
    description: "Add your first project here",
    link: "#",
  },
  {
    title: "Project 2",
    description: "Add more projects as you build",
    link: "#",
  },
];
---

<Base title="Projects" description="My work and projects">
  <h1>Projects</h1>
  
  <ul style="list-style: none; padding: 0;">
    {projects.map((project) => (
      <li style="margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #e5e5e5;">
        <h3><a href={project.link}>{project.title}</a></h3>
        <p>{project.description}</p>
      </li>
    ))}
  </ul>
</Base>
